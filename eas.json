{
  "$schema": "https://json.schemastore.org/eas.json",
  "cli": {
    "version": ">= 21.7.1",
    "appVersionSource": "remote"
  },

  "build": {
    "base": {
      "node": "22.16.0",
      "env": {
        "EXPO_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com"
      }
    },

    "development": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "development",
        "BINGD_LANE": "development",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "ios": { "simulator": false },
      "android": { "buildType": "apk" }
    },

    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "preview",
        "BINGD_LANE": "preview",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": { "buildType": "apk" }
    },

    "beta": {
      "extends": "base",
      "environment": "preview",
      "distribution": "store",
      "channel": "beta",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "BINGD_LANE": "beta",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": { "buildType": "app-bundle" }
    },

    "production": {
      "extends": "base",
      "environment": "production",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "BINGD_LANE": "production"
      },
      "android": { "buildType": "app-bundle" }
    }
  },

  "submit": {
    "beta": {
      "ios": {
        "appleTeamId": "98729PG8GD",
        "ascAppId": "6803954532",
        "bundleIdentifier": "app.bingd"
      },
      "android": {
        "track": "alpha",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "ios": {
        "appleTeamId": "98729PG8GD",
        "ascAppId": "6803954532",
        "bundleIdentifier": "app.bingd"
      }
    }
  }
}
