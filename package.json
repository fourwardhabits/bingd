{
  "name": "bingd",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest",
    "test:db": "node --test \"supabase/tests/*.test.mjs\"",
    "test:remote": "node supabase/tests/remote-smoke.mjs",
    "seed:fetch": "node supabase/seed/fetch-catalogue.mjs",
    "seed:migration": "node supabase/seed/make-seed-migration.mjs",
    "catalogue:enrich": "node supabase/seed/backfill-tmdb.mjs",
    "report:recommendations": "node scripts/recommendation-report.mjs",
    "trending:refresh": "node supabase/seed/refresh-trending.mjs",
    "functions:check": "deno check --config supabase/functions/tmdb-adapter/deno.json supabase/functions/tmdb-adapter/index.ts",
    "functions:lint": "deno lint --config supabase/functions/tmdb-adapter/deno.json supabase/functions/tmdb-adapter",
    "brand:render": "node assets/brand/render.mjs",
    "build:web": "node web/build.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.12",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.10",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-manipulator": "~57.0.10",
    "expo-image-picker": "~57.0.10",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.11",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.13",
    "expo-web-browser": "~57.0.2",
    "posthog-react-native": "^4.63.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "deno": "^2.9.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "~5.9.2"
  }
}
