# Copy to .env and fill in. .env is git-ignored.
# Every value here is safe to expose in a client bundle. The Supabase anon key is
# constrained by row level security, a Sentry DSN only accepts events, and a
# PostHog project token is write-only. None of them reads anything back.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Leave blank to run without crash reporting or analytics — both
# degrade to no-ops rather than failing, so a contributor needs no accounts.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# development | preview | production — selects the variant in app.config.ts
APP_VARIANT=development

# Not read by the app. Used by EAS at build time to upload source maps, and
# stored as an EAS secret rather than committed. See README.
# SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# There is deliberately no TMDB variable here, and adding one would be a bug.
#
# Every value in this file reaches the client bundle, and a bundle is public
# however the app is distributed. TMDB is reached only through the tmdb-adapter
# Edge Function, which holds the key as a Supabase secret (AD-8, PRD §19):
#
#   npx supabase secrets set TMDB_ACCESS_TOKEN="..."
#
# Operator credentials for the catalogue backfill — SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY — go in .env.local, which is git-ignored and has no
# committed example, because there is no safe default to copy.
# See supabase/functions/README.md.
# ---------------------------------------------------------------------------
