# Copy to .env and fill in. .env is git-ignored.
# Both values are safe to expose in a client bundle: the anon key is
# constrained by row level security, which is why every table denies by default.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# development | preview | production — selects the variant in app.config.ts
APP_VARIANT=development
